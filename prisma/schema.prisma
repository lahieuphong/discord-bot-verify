generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
}

model EmailVerification {
  id                  String                  @id @default(uuid()) @db.Uuid
  guildId             String                  @db.VarChar(32)
  discordUserId       String                  @db.VarChar(32)
  email               String?                 @db.VarChar(254)
  emailMasked         String?                 @db.VarChar(254)
  status              EmailVerificationStatus @default(UNVERIFIED)
  otpHash             String?                 @db.Char(64)
  otpExpiresAt        DateTime?
  resendAvailableAt   DateTime?
  attemptsRemaining   Int                     @default(0)
  verifiedAt          DateTime?
  verifiedRoleId      String?                 @db.VarChar(32)
  joinedAt            DateTime                @default(now())
  leftAt              DateTime?
  lastPromptedAt      DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([guildId, discordUserId])
  @@index([status, otpExpiresAt])
  @@map("email_verifications")
}

model User {
  id            Int      @id @default(autoincrement())
  accountName   String   @map("account_name") @db.VarChar(100)
  phone         String   @db.VarChar(32)
  cccd          String   @db.VarChar(32)
  guildId       String   @db.VarChar(32)
  discordUserId String   @db.VarChar(32)
  email         String?  @db.VarChar(254)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("update_at")

  @@unique([guildId, discordUserId])
  @@map("users")
}


enum VerificationPromptDelivery {
  DM
  CHANNEL
}

/// Remembers that a member was already sent the verification button, so the
/// startup scan of existing members does not send it again on every restart.
model VerificationPrompt {
  id            Int                        @id @default(autoincrement())
  guildId       String                     @db.VarChar(32)
  discordUserId String                     @db.VarChar(32)
  deliveredVia  VerificationPromptDelivery @map("delivered_via")
  promptedAt    DateTime                   @default(now()) @map("prompted_at")

  @@unique([guildId, discordUserId])
  @@map("verification_prompts")
}

/// One call to Gemini (Discord /question or POST /question). Google offers no
/// API for the remaining quota of a key, so the bot counts its own usage for
/// the Gemini tab of the admin page. The question text is never stored.
model GeminiRequest {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now()) @map("created_at")
  /// First 12 hex characters of SHA-256(key): usage per key, without the key.
  keyFingerprint String   @map("key_fingerprint") @db.VarChar(16)
  model          String   @db.VarChar(100)
  source         String   @db.VarChar(16)
  requester      String?  @db.VarChar(100)
  ok             Boolean
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  totalTokens    Int?     @map("total_tokens")
  durationMs     Int      @map("duration_ms")
  errorStatus    Int?     @map("error_status")
  errorKind      String?  @map("error_kind") @db.VarChar(32)
  errorMessage   String?  @map("error_message") @db.VarChar(500)
  quotaId        String?  @map("quota_id") @db.VarChar(200)
  quotaValue     Int?     @map("quota_value")
  retryAfterSec  Int?     @map("retry_after_sec")

  @@index([keyFingerprint, createdAt])
  @@index([createdAt])
  @@map("gemini_requests")
}

/// Who did what on the admin page (/export-excel) and which verification
/// events happened in Discord, for the "Nhật ký" tab. Kept 180 days. Never
/// holds phone numbers, CCCDs or Gemini keys.
model AdminAuditLog {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  /// "web" (admin page) or "discord".
  source String   @db.VarChar(16)
  /// e.g. "login", "excel_download" (see src/audit/audit.types.ts).
  action String   @db.VarChar(32)
  /// Admin username, the username tried at login, or "name (discord id)".
  actor  String?  @db.VarChar(120)
  ip     String?  @db.VarChar(64)
  detail String?  @db.VarChar(300)

  @@index([at])
  @@index([action, id])
  @@map("admin_audit_log")
}
